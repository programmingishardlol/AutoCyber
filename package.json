{
  "name": "autocyber",
  "version": "0.1.0",
  "private": true,
  "description": "AutoCyber is an AI security engineer for AI-built startup stacks.",
  "packageManager": "pnpm@9.15.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "scanner:test": "pnpm --filter @autocyber/scanner test",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "format": "prettier --check ."
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  }
}
